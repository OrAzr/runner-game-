# Signs the Unity Xcode export and uploads it to TestFlight.
# Certificates are created on the runner by match (no Mac of Or's required)
# and stored encrypted in the private repo from MATCH_GIT_URL.
default_platform(:ios)

BUNDLE_ID = "com.outpostzero.game"
APP_NAME = "Outpost Zero"
SCHEME = "Unity-iPhone"

platform :ios do
  desc "Sign the exported Xcode project and upload an IPA to TestFlight"
  lane :beta do |options|
    xcode_dir = File.expand_path(options[:xcode_dir] || ENV["XCODE_DIR"] || ".")
    xcodeproj = File.join(xcode_dir, "#{SCHEME}.xcodeproj")
    UI.user_error!("Xcode project not found at #{xcodeproj}") unless File.directory?(xcodeproj)

    setup_ci if ENV["CI"]

    key_path = ENV.fetch("APP_STORE_CONNECT_KEY_PATH")
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: key_path,
      duration: 1200,
      in_house: false
    )

    # Creates the bundle id and the App Store Connect app record when they do not exist yet.
    produce(
      app_identifier: BUNDLE_ID,
      app_name: APP_NAME,
      sku: "outpostzero-game",
      language: "en-US",
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      api_key: api_key,
      skip_itc: false,
      skip_devcenter: false
    )

    token = ENV.fetch("MATCH_GIT_TOKEN")
    ENV["MATCH_GIT_BASIC_AUTHORIZATION"] = Base64.strict_encode64("x-access-token:#{token}")
    match(
      type: "appstore",
      app_identifier: BUNDLE_ID,
      api_key: api_key,
      readonly: false,
      generate_apple_certs: true,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_branch: "main",
      git_full_name: "Outpost Zero CI",
      git_user_email: "ci@users.noreply.github.com",
      team_id: ENV.fetch("APPLE_TEAM_ID")
    )

    profile_name = ENV["sigh_#{BUNDLE_ID}_appstore_profile-name"]
    UI.user_error!("match did not export a provisioning profile name") if profile_name.to_s.empty?

    update_code_signing_settings(
      use_automatic_signing: false,
      path: xcodeproj,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: [SCHEME],
      bundle_identifier: BUNDLE_ID
    )

    info_plist = File.join(xcode_dir, "Info.plist")
    if File.exist?(info_plist)
      set_info_plist_value(
        path: info_plist,
        key: "ITSAppUsesNonExemptEncryption",
        value: false
      )
    end

    ipa_dir = File.join(xcode_dir, "ipa")
    build_app(
      project: xcodeproj,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_team_id: ENV.fetch("APPLE_TEAM_ID"),
      export_options: {
        signingStyle: "manual",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
        provisioningProfiles: {
          BUNDLE_ID => profile_name
        }
      },
      xcargs: "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')} CODE_SIGN_STYLE=Manual",
      output_directory: ipa_dir,
      output_name: "OutpostZero.ipa",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: File.join(ipa_dir, "OutpostZero.ipa"),
      skip_waiting_for_build_processing: true
    )
  end
end
